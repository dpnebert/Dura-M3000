# Dura M3000 ESP-IDF defaults.
# PCB832 revX3 target: ESP32-S3-WROOM-1-N8R2, 8 MB flash / 2 MB fitted PSRAM.
# CAD N4R2 entry is a footprint choice, not the fitted flash capacity.
# PSRAM remains disabled by policy; internal memory-bus pins remain reserved.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# CONFIG_ESPTOOLPY_FLASHSIZE_16MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
# CONFIG_PARTITION_TABLE_SINGLE_APP is not set
# CONFIG_PARTITION_TABLE_TWO_OTA is not set
# CONFIG_PARTITION_TABLE_TWO_OTA_LARGE is not set
# CONFIG_PARTITION_TABLE_CUSTOM is not set
CONFIG_PARTITION_TABLE_FILENAME="partitions_singleapp_large.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y
# CONFIG_SPIRAM is not set

# flow_isr() calls gpio_get_level() while NVS operations can disable the flash
# cache. Keep the GPIO control path in IRAM so flow edges remain cache-safe.
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
# Four notifying characteristics across three bonds require 12 entries;
# retain headroom because the official tablet app still overflowed at 12.
CONFIG_BT_NIMBLE_MAX_CCCDS=16

CONFIG_DURA_APP_M3000_LEGACY_ONLY=y

CONFIG_DURA_BOARD_S3_WROOM_1=y
CONFIG_DURA_BOARD_VOLUME_GALLON_DECIMALS=2
CONFIG_DURA_BOARD_VOLUME_LITER_DECIMALS=2
CONFIG_DURA_BOARD_VOLUME_OUNCE_DECIMALS=2
CONFIG_DURA_BOARD_VOLUME_2DP_LIMIT_TENTHS=1999
CONFIG_DURA_BOARD_ENABLE_HARDWARE_TASK=y
# Full-function PCB832 revX3 profile: pump47, Recirc/Inject17/18 and Recirc35.
# Software enablement is not physical/electrical acceptance. Deep sleep retains
# the existing delay. Older GPIO21 LED-bench images do not match this board.
CONFIG_DURA_BOARD_ENABLE_PUMP_OUTPUT=y
CONFIG_DURA_BOARD_ENABLE_RECIRC_INPUT=y
CONFIG_DURA_BOARD_ENABLE_EV_OUTPUTS=y
CONFIG_DURA_BOARD_ENABLE_DEEP_SLEEP=y
CONFIG_DURA_BOARD_DEEP_SLEEP_DELAY_SEC=60

# PCB832 revX3 GPIO map. N8R2 memory bus uses internal GPIO26-GPIO32;
# GPIO35 is available for Recirc. SELECT/BACK mapping remains owner-deferred.
CONFIG_DURA_BOARD_GPIO_FLOW_A=21
CONFIG_DURA_BOARD_GPIO_FLOW_B=2
CONFIG_DURA_BOARD_GPIO_KEY_1=6
CONFIG_DURA_BOARD_GPIO_KEY_2=7
CONFIG_DURA_BOARD_GPIO_KEY_3=5
CONFIG_DURA_BOARD_GPIO_KEY_4=4
CONFIG_DURA_BOARD_GPIO_RECIRC_INPUT=35
CONFIG_DURA_BOARD_GPIO_LCD_SPI_CLK=9
CONFIG_DURA_BOARD_GPIO_LCD_SPI_MOSI=10
CONFIG_DURA_BOARD_GPIO_LCD_CS=11
CONFIG_DURA_BOARD_GPIO_LCD_A0_DC=12
CONFIG_DURA_BOARD_GPIO_LCD_RST=13
CONFIG_DURA_BOARD_GPIO_LCD_BACKLIGHT=14
CONFIG_DURA_BOARD_GPIO_PUMP_OUTPUT=47
CONFIG_DURA_BOARD_GPIO_RECIRC_EV_OUTPUT=17
CONFIG_DURA_BOARD_GPIO_INJECT_EV_OUTPUT=18
CONFIG_DURA_BOARD_GPIO_BATTERY_ADC=1
CONFIG_DURA_BOARD_GPIO_FIELD_SENSE_ADC=8
# CONFIG_DURA_BOARD_ENABLE_LEGACY_POWER_OUTPUTS is not set
CONFIG_DURA_BOARD_FLOW_ACTIVE_LOW=y
CONFIG_DURA_BOARD_FLOW_PULLUP=y
# CONFIG_DURA_BOARD_FLOW_PULLDOWN is not set
CONFIG_DURA_BOARD_BUTTON_ACTIVE_LOW=y
CONFIG_DURA_BOARD_BUTTON_PULLUP=y
# CONFIG_DURA_BOARD_BUTTON_PULLDOWN is not set
CONFIG_DURA_BOARD_LCD_CS_ACTIVE_LOW=y
CONFIG_DURA_BOARD_LCD_RST_ACTIVE_LOW=y
# CONFIG_DURA_BOARD_LCD_BACKLIGHT_ACTIVE_LOW is not set
# CONFIG_DURA_BOARD_PUMP_OUTPUT_ACTIVE_LOW is not set

CONFIG_BLE_SHELL_DEVICE_NAME="Dura HF Meter M3000"
CONFIG_BLE_SHELL_PROJECT_ID="DURA_M3000"
CONFIG_BLE_SHELL_MODULE_NAME="Dura-M3000-BLE"
CONFIG_BLE_SHELL_MODULE_VERSION="s3-wroom-1"
CONFIG_BLE_SHELL_FIRMWARE_VERSION="0.1.0"
CONFIG_BLE_SHELL_PAIR_ADV_SECONDS=60
CONFIG_BLE_SHELL_ADV_ON_BOOT=y
CONFIG_BLE_SHELL_PAIR_BUTTON_GPIO=-1
CONFIG_BLE_SHELL_PAIR_BUTTON_ACTIVE_LOW=y
CONFIG_BLE_SHELL_PAIR_BUTTON_PULLUP=y
# CONFIG_BLE_SHELL_PAIR_BUTTON_PULLDOWN is not set
CONFIG_BLE_SHELL_MAX_PAYLOAD=1024
CONFIG_BLE_SHELL_SECURITY_PAIR_WINDOW_REQUIRED=y
CONFIG_DURA_BOARD_TASK_STACK=4096
CONFIG_DURA_BOARD_TASK_PRIORITY=5
CONFIG_DURA_BOARD_UI_PERIOD_MS=100
CONFIG_DURA_BOARD_SAVE_PERIOD_MS=5000
CONFIG_DURA_BOARD_LOW_BATTERY_THRESHOLD_PERCENT=20
CONFIG_DURA_BOARD_LOW_BATTERY_BLINK_ON_MS=1000
CONFIG_DURA_BOARD_LOW_BATTERY_BLINK_OFF_MS=1000
CONFIG_DURA_BOARD_BUTTON_HOLD_MAX_RATE_X=10
CONFIG_DURA_BOARD_SETTINGS_HOLD_MS=1500
CONFIG_DURA_LCD_WIDTH=128
CONFIG_DURA_LCD_HEIGHT=64
CONFIG_DURA_RECIPE_MAX_NAME_LEN=32
CONFIG_DURA_RECIPE_MAX_LIQUID_NAME_LEN=32
CONFIG_DURA_RECIPE_MAX_INGREDIENTS=16
CONFIG_DURA_RECIPE_MAX_CUSTOM_LIQUIDS=32
CONFIG_BLE_SHELL_DEFAULT_SERIAL_ID="UNSET"
CONFIG_BLE_SHELL_STATUS_FAULT_MASK=0x01
CONFIG_BLE_SHELL_STATUS_DIAGNOSTIC_MASK=0x02
CONFIG_BLE_SHELL_STATUS_UNLOCKED_MASK=0x04
CONFIG_DURA_SERIAL_CONSOLE_STACK_SIZE=8192
CONFIG_DURA_APP_COMMAND_STACK_SIZE=16384
CONFIG_DURA_APP_QEMU_NO_RADIO=n
# UART0 programming/monitor path. Keep native USB Serial/JTAG disabled for
# this design; use UART0 TX/RX plus EN and GPIO0/BOOT for recovery flashing.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_USB_CDC is not set
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
# CONFIG_ESP_CONSOLE_NONE is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED is not set
# CONFIG_USJ_ENABLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_ROM_SERIAL_PORT_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_ESPTOOLPY_MONITOR_BAUD=115200
# CONFIG_DURA_BOARD_RECIRC_INPUT_ACTIVE_LOW is not set
# CONFIG_DURA_BOARD_RECIRC_INPUT_PULLUP is not set
# CONFIG_DURA_BOARD_RECIRC_INPUT_PULLDOWN is not set
